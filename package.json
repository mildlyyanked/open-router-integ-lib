{
  "name": "@mildlyyanked/openrouter",
  "version": "0.1.0",
  "description": "OpenRouter integration for TypeScript apps: use cases, prompt templates, structured output with validation + repair, retries, priority queue, fallbacks, usage, model catalog, mock/recording providers and a key-holding proxy.",
  "type": "module",
  "main": "./ts/dist/index.js",
  "types": "./ts/dist/index.d.ts",
  "exports": {
    ".": { "types": "./ts/dist/index.d.ts", "import": "./ts/dist/index.js" },
    "./node": { "types": "./ts/dist/node.d.ts", "import": "./ts/dist/node.js" }
  },
  "files": ["ts/dist", "README.md"],
  "scripts": {
    "build": "tsc -p ts/tsconfig.json",
    "prepare": "tsc -p ts/tsconfig.json",
    "test": "tsc -p ts/tsconfig.test.json && node --test ts/build/test/*.test.js"
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
